{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Dependencias instaladas no build'",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "formetas/build/web",
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|canvaskit/|flutter.js|flutter_bootstrap.js|flutter_service_worker.js|main.dart.js|main.dart.js.map|manifest.json|favicon.png|version.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(main.dart.js|flutter.js|flutter_bootstrap.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
